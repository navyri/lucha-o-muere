# Backend Lucha o Muere — copia este archivo a .env y completa los valores.
# En Render se configuran como Environment Variables (igual que aquí).

# Puerto (Render lo inyecta solo; en local usa 3000)
PORT=3000

# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Conexión a PostgreSQL (Neon: Settings → Connection Details)
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
DB_USER=default
DB_PASSWORD=

# "true" para Neon/Supabase (exigen SSL); "false" o vacío para PG local
DB_SSL=true
